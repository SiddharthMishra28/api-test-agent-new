<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API Test Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; background-color: #f7f7f7; color: #333; }
        .container { max-width: 1200px; margin: 20px auto; padding: 20px; background-color: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1); border-radius: 8px; }
        h1, h2 { color: #111; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .summary-card { padding: 20px; border-radius: 8px; color: #fff; }
        .summary-card.passed { background-color: #28a745; }
        .summary-card.failed { background-color: #dc3545; }
        .summary-card.partial { background-color: #ffc107; color: #111 }
        .summary-card h3 { margin: 0 0 10px; }
        .summary-card p { font-size: 24px; margin: 0; font-weight: bold; }
        .step { border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; }
        .step-summary { padding: 15px; background-color: #f1f1f1; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
        .step-summary:hover { background-color: #e9e9e9; }
        .step-details { padding: 20px; border-top: 1px solid #ddd; background-color: #fff; }
        .step-details h3 { margin-top: 0; }
        .assertion-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .assertion-table th, .assertion-table td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        .assertion-table th { background-color: #f9f9f9; }
        .assertion-ok { color: #28a745; font-weight: bold; }
        .assertion-fail { color: #dc3545; font-weight: bold; }
        pre { background-color: #2d2d2d; color: #f1f1f1; padding: 15px; border-radius: 4px; white-space: pre-wrap; word-wrap: break-word; }
        .json-viewer { position: relative; }
        .copy-btn { position: absolute; top: 10px; right: 10px; background-color: #444; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; }
        .copy-btn:hover { background-color: #555; }
    </style>
</head>
<body>
    <div class="container">
        <h1>API Test Report</h1>
        <p><strong>Test Case:</strong> <%= report.testCase.title %></p>
        <p><strong>Run Time:</strong> <%= new Date(report.startTime).toLocaleString() %></p>

        <div class="summary">
            <div class="summary-card <%= report.summary.status.toLowerCase() %>">
                <h3>Overall Status</h3>
                <p><%= report.summary.status %></p>
            </div>
            <div class="summary-card passed">
                <h3>Passed Assertions</h3>
                <p><%= report.summary.passedAssertions %></p>
            </div>
            <div class="summary-card failed">
                <h3>Failed Assertions</h3>
                <p><%= report.summary.failedAssertions %></p>
            </div>
        </div>

        <h2>Test Steps</h2>
        <% report.stepResults.forEach(stepResult => { %>
            <details class="step" open>
                <summary class="step-summary">
                    <strong><%= stepResult.stepId %>: <%= report.testCase.steps.find(s => s.id === stepResult.stepId).name %></strong>
                    <span>
                        <% const stepPassed = stepResult.assertionResults.every(ar => ar.ok); %>
                        <span class="<%= stepPassed ? 'assertion-ok' : 'assertion-fail' %>">
                            <%= stepPassed ? 'PASSED' : 'FAILED' %>
                        </span>
                    </span>
                </summary>
                <div class="step-details">
                    <h3>Request</h3>
                    <pre><code><%= stepResult.request.method %> <%= stepResult.request.url %></code></pre>
                    <h4>Headers</h4>
                    <div class="json-viewer">
                        <button class="copy-btn" onclick="copyToClipboard(this)">Copy</button>
                        <pre><code><%= JSON.stringify(stepResult.request.headers || {}, null, 2) %></code></pre>
                    </div>
                    <h4>Body</h4>
                    <div class="json-viewer">
                        <button class="copy-btn" onclick="copyToClipboard(this)">Copy</button>
                        <pre><code><%= JSON.stringify(stepResult.request.body || {}, null, 2) %></code></pre>
                    </div>

                    <h3>Response</h3>
                    <% if (stepResult.response) { %>
                        <p><strong>Status:</strong> <%= stepResult.response.status %> | <strong>Duration:</strong> <%= stepResult.response.durationMs %>ms</p>
                        <h4>Headers</h4>
                        <div class="json-viewer">
                            <button class="copy-btn" onclick="copyToClipboard(this)">Copy</button>
                            <pre><code><%= JSON.stringify(stepResult.response.headers || {}, null, 2) %></code></pre>
                        </div>
                        <h4>Body</h4>
                        <div class="json-viewer">
                            <button class="copy-btn" onclick="copyToClipboard(this)">Copy</button>
                            <pre><code><%= JSON.stringify(stepResult.response.body || {}, null, 2) %></code></pre>
                        </div>
                    <% } else { %>
                        <p><strong>Error:</strong> <%= stepResult.error %></p>
                    <% } %>

                    <h3>Assertions</h3>
                    <table class="assertion-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Message</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% stepResult.assertionResults.forEach(ar => { %>
                                <tr>
                                    <td class="<%= ar.ok ? 'assertion-ok' : 'assertion-fail' %>"><%= ar.ok ? '✔ Passed' : '✖ Failed' %></td>
                                    <td><%= ar.message %></td>
                                    <td><pre><code><%= JSON.stringify(ar.details || {}, null, 2) %></code></pre></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </details>
        <% }) %>
    </div>
    <script>
        function copyToClipboard(button) {
            const pre = button.nextElementSibling;
            const text = pre.innerText;
            navigator.clipboard.writeText(text).then(() => {
                button.innerText = 'Copied!';
                setTimeout(() => { button.innerText = 'Copy'; }, 2000);
            }).catch(err => {
                console.error('Failed to copy text: ', err);
            });
        }
    </script>
</body>
</html>
